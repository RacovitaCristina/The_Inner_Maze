# --- Unity Standard Folders (NU STERGE ASTEA) ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Uu]ser[Ss]ettings/

# --- Meta Files (ESENȚIALE - NU LE IGNORA) ---
!/[Aa]ssets/**/*.meta

# --- IDE & Autogenerated Files (Visual Studio, Rider, etc.) ---
.vs/
.gradle/
.idea/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# --- Unity Generated Debug Files ---
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt

# --- Operating System Junk (Mac & Windows) ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# --- Builds & Exports ---
*.apk
*.aab
*.unitypackage

# --- Crashlytics ---
crashlytics-build.properties

# --- Vuforia / Local Packages ---
/Packages/*.tgz
/Packages/com.ptc.vuforia.engine-*.tgz

# -----------------------------------------------------------
# IMPORTANT: NU adăuga mai jos *.fbx, *.obj, *.mp4, *.png!
# Acestea trebuie să fie VIZIBILE pentru Git.
# Dacă sunt mari (>100MB), se ocupă Git LFS de ele, nu gitignore.
# -----------------------------------------------------------